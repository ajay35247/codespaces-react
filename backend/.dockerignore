# Backend image is built with the **repo root** as the Docker build context
# (matches Railway + docker-compose.yml + docker-compose.dev.yml). This file
# is therefore not the active .dockerignore for the backend image — the root
# `.dockerignore` is. It is kept here as a reference / safety net for anyone
# who manually runs `docker build -f Dockerfile.backend backend/` (which is
# NOT supported; that will fail because the Dockerfile expects the repo root).

# VCS / editor
.git
.gitignore
.vscode
.idea

# Local env files (NEVER ship secrets into images)
.env
.env.*
!.env.example
!.env.prod.example

# Installed deps & build outputs (let `npm install` rebuild inside the image)
node_modules
**/node_modules
coverage
.cache

# Tests / docs / CI artefacts
tests
__tests__
*.test.js
*.spec.js
docs

# Logs & tmp
*.log
npm-debug.log*
tmp
temp

# OS junk
.DS_Store
Thumbs.db
