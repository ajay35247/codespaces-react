# Backend Docker build context = ./backend
# Keep image small & deterministic. Anything not needed by `node src/index.js`
# at runtime (or `npm install` at build) should be ignored.

# VCS / editor
.git
.gitignore
.vscode
.idea

# Local env files (NEVER ship secrets into images)
.env
.env.*
!.env.example
!.env.prod.example

# Installed deps & build outputs (let `npm install` rebuild inside the image)
node_modules
**/node_modules
coverage
.cache

# Tests / docs / CI artefacts
tests
__tests__
*.test.js
*.spec.js
docs

# Logs & tmp
*.log
npm-debug.log*
tmp
temp

# OS junk
.DS_Store
Thumbs.db
