# Active .dockerignore for the backend image. The backend image is always
# built with `./backend` as the Docker build context — Railway (Root Directory
# = backend/, see ./railway.toml + ./Dockerfile.backend), prod compose
# (docker-compose.yml: context: ./backend), and dev compose
# (docker-compose.dev.yml: context: ./backend) all agree.

# VCS / editor
.git
.gitignore
.vscode
.idea

# Local env files (NEVER ship secrets into images)
.env
.env.*
!.env.example
!.env.prod.example

# Installed deps & build outputs (let `npm install` rebuild inside the image)
node_modules
**/node_modules
coverage
.cache

# Tests / docs / CI artefacts
tests
__tests__
*.test.js
*.spec.js
docs

# Logs & tmp
*.log
npm-debug.log*
tmp
temp

# OS junk
.DS_Store
Thumbs.db
