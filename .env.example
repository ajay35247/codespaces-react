# ─── Frontend Environment Variables ─────────────────────────────────────────
# Copy this file to .env.local for development, set in Vercel dashboard for production.
# DO NOT commit .env.local to version control.

# Backend API base URL (no trailing slash, include /api)
VITE_API_URL=https://your-backend.onrender.com/api

# ─── HIDDEN ADMIN PANEL (SECRET - DO NOT DISCLOSE PUBLICLY) ──────────────────
# Hidden admin panel route path (only accessed via direct URL, not discoverable from UI)
# Must match VITE_ADMIN_PANEL_PATH you chose when deploying (keep this secret)
# Generate a random path: /your-secret-path-here
VITE_ADMIN_PANEL_PATH=REPLACE_ME_with_secret_path

# Hidden admin API segment (must match backend ADMIN_PRIVATE_PATH_SEGMENT)
# Used to route admin requests to hidden control plane
VITE_ADMIN_API_SEGMENT=REPLACE_ME_with_secret_segment
# Alias supported by frontend for parity with backend variable naming
VITE_ADMIN_PRIVATE_PATH_SEGMENT=REPLACE_ME_with_secret_segment

# Google Maps (used by TrackingMap)
VITE_GOOGLE_MAP_API_KEY=your_google_maps_api_key
# Legacy name supported for backward compatibility
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Razorpay public key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# App environment
VITE_APP_ENV=production
