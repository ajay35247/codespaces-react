# Backend Dockerfile — designed to be built with the **repo root** as the
# Docker build context. This matches Railway's default behaviour (railway.toml
# lives at the repo root and no Root Directory override is required) and
# `context: .` in docker-compose.yml / docker-compose.dev.yml.
#
# COPY paths are therefore prefixed with `backend/`. This single canonical
# layout works on Railway, in prod compose, and in dev compose — no GUI
# settings to drift, no two ways of building the same image.
#
# If you accidentally build from inside `backend/`, the COPYs below will fail
# loudly (e.g. `backend/package.json: not found`) instead of silently shipping
# the frontend's package.json + src and crashing later at runtime.

FROM node:20-alpine AS dev
WORKDIR /app
COPY backend/package.json backend/package-lock.json* ./
RUN npm install
COPY backend/src ./src
EXPOSE 5000
CMD ["npx", "nodemon", "src/index.js"]

FROM node:20-alpine
WORKDIR /app
COPY backend/package.json backend/package-lock.json* ./
RUN npm install --omit=dev && npm cache clean --force
COPY backend/src ./src
# Fail the build loudly (instead of silently shipping a broken image) if the
# entry script is missing — protects against Docker build context regressions.
RUN test -f /app/src/index.js || (echo 'ERROR: /app/src/index.js missing — Dockerfile build context is wrong (expected the repo root, with COPY backend/...).' >&2 && exit 1)
RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
    && chown -R appuser:appgroup /app
USER appuser
EXPOSE 5000
CMD ["node", "src/index.js"]
