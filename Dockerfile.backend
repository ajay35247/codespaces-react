# Backend Dockerfile — designed to be built with the `backend/` directory as
# the build context. This matches Railway (Root Directory = backend/) and the
# `context: ./backend` in docker-compose.yml / docker-compose.dev.yml.
#
# COPY paths are therefore relative to `backend/` (no `backend/` prefix). If
# you build from the repo root by mistake, the COPYs below will fail loudly
# (e.g. `package.json: not found`) instead of silently shipping the frontend's
# package.json + src and crashing later with `Cannot find module 'src/index.js'`.

FROM node:20-alpine AS dev
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY src ./src
EXPOSE 5000
CMD ["npx", "nodemon", "src/index.js"]

FROM node:20-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install --omit=dev && npm cache clean --force
COPY src ./src
# Fail the build loudly (instead of silently shipping a broken image) if the
# entry script is missing — protects against Docker build context regressions.
RUN test -f /app/src/index.js || (echo 'ERROR: /app/src/index.js missing — Dockerfile build context is wrong (expected the backend/ directory).' >&2 && exit 1)
RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
    && chown -R appuser:appgroup /app
USER appuser
EXPOSE 5000
CMD ["node", "src/index.js"]
