# ─── Local Development Environment ───────────────────────────────────────────
# Copy this file to .env.dev and fill in the values, then start the local
# stack with:
#
#   docker-compose --env-file .env.dev -f docker-compose.dev.yml up --build
#
# Every variable below has a safe development default in docker-compose.dev.yml,
# so for the simplest local run you can leave them blank — the stack will boot
# with placeholder values and you'll be able to register, login, browse, and
# exercise the API.  Override here only the values you actually need (e.g. real
# Razorpay test keys to exercise the payment flow, or a real Google Maps key
# to render maps).
#
# This file MUST NOT be committed.  See .gitignore.

# ─── Auth (long random strings; >= 32 chars each) ────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ─── Hidden admin panel ──────────────────────────────────────────────────────
# A random URL segment that obscures the admin panel from drive-by discovery.
# Pick anything you'll remember locally (the production value is rotated).
ADMIN_EMAIL=admin@dev.local
ADMIN_BOOTSTRAP_PASSWORD=Admin@Dev1234!
ADMIN_PRIVATE_PATH_SEGMENT=_dev_admin

# Frontend mirrors of the admin segment so the React app routes to the right
# admin URL in dev.  All three should match ADMIN_PRIVATE_PATH_SEGMENT above.
VITE_ADMIN_PANEL_PATH=/_dev_admin
VITE_ADMIN_API_SEGMENT=_dev_admin
VITE_ADMIN_PRIVATE_PATH_SEGMENT=_dev_admin

# ─── Razorpay (use TEST mode keys from dashboard.razorpay.com) ───────────────
# Leave blank to use the placeholder values from docker-compose.dev.yml; you
# can register/login/browse without these but the payment flow won't go end
# to end until you supply real test keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# ─── Google Maps (optional in dev) ───────────────────────────────────────────
# Required only if you want the Tracking page to render real map tiles.
VITE_GOOGLE_MAP_API_KEY=

# ─── Email (defaults to the MailHog container in docker-compose.dev.yml) ─────
# MailHog captures every outgoing email locally — view at http://localhost:8025.
# To use a real SMTP service in dev instead, set EMAIL_HOST/PORT/USER/PASS.
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USER=dev
EMAIL_PASS=dev
EMAIL_FROM=Speedy Trucks Dev <noreply@localhost>
